{
  "name": "necko7-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run docs:build",
    "api:sync": "node scripts/scripting-docs.mjs sync",
    "docs:generate": "node scripts/scripting-docs.mjs generate",
    "docs:check": "node scripts/scripting-docs.mjs check",
    "docs:build": "npm run docs:check && vitepress build docs && node scripts/check-doc-links.mjs",
    "docs:dev": "npm run docs:generate && vitepress dev docs --host 127.0.0.1 --port 4174",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 4174",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "framer-motion": "^13.2.0",
    "i18next": "^26.4.2",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.8",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "linkedom": "^0.18.13",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4"
  }
}
